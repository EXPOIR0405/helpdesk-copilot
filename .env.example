OPENAI_API_KEY=

# 없으면 로컬 파일(data/index, data/logs)로 동작
SUPABASE_URL=
# Supabase 대시보드 > Project Settings > API Keys > secret 키 (서버 전용, 절대 공개 금지)
SUPABASE_SECRET_KEY=

# Vercel Cron이 /api/keepalive 호출 시 보내는 값. 임의의 긴 문자열
CRON_SECRET=

# Gemini 모델을 쓸 때만 필요 (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# 생성 모델 교체 (후보: src/core/models.ts). 비우면 gpt-5.4-mini
GENERATION_MODEL=
