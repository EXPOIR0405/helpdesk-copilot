OPENAI_API_KEY=

# 없으면 로컬 파일(data/index, data/logs)로 동작
SUPABASE_URL=
# Supabase 대시보드 > Project Settings > API Keys > secret 키 (서버 전용, 절대 공개 금지)
SUPABASE_SECRET_KEY=

# Vercel Cron이 /api/keepalive 호출 시 보내는 값. 임의의 긴 문자열
CRON_SECRET=

# 기본 생성 모델(gemini-3.8-flash)용 (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# 생성 모델 교체 (후보: src/core/models.ts, 선택 근거: docs/model-selection.md). 비우면 gemini-3.8-flash
GENERATION_MODEL=
# 기본 모델 실패 시 대체 모델. 다른 제공사로. 줄을 지우면 gpt-5.4-mini, 빈 값이면 대체 없음
# FALLBACK_MODEL=gpt-5.4-mini

# 운영 알림 (Slack 앱 > Incoming Webhooks). 없으면 콘솔로만. 비밀값으로 다룰 것
SLACK_WEBHOOK_URL=
